<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="true" title="RESIDEX Help" width="740" height="680" minWidth="520" minHeight="420"
         type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@Residex.css" />
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <BorderPane styleClass="help-root">
        <top>
          <VBox spacing="8" styleClass="help-header">
            <Label text="RESIDEX Command Reference" styleClass="help-title" wrapText="true" />
            <Label text="Command syntax, details and examples. Available offline."
                   styleClass="help-secondary" wrapText="true" />
            <Label text="UPPER_CASE words are values you supply. [Square brackets] mark optional values."
                   styleClass="help-secondary" wrapText="true" />
          </VBox>
        </top>
        <center>
          <ScrollPane fx:id="commandScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="help-scroll">
            <content>
              <VBox fx:id="commandCards" spacing="16" minWidth="0">
                <padding>
                  <Insets top="4" right="24" bottom="20" left="24" />
                </padding>
              </VBox>
            </content>
          </ScrollPane>
        </center>
        <bottom>
          <HBox alignment="CENTER_LEFT" spacing="16" styleClass="help-footer">
            <Label fx:id="helpMessage" wrapText="true" minWidth="0" maxWidth="Infinity"
                   HBox.hgrow="ALWAYS" styleClass="help-secondary" />
            <Button fx:id="copyButton" text="Copy URL" mnemonicParsing="false" onAction="#copyUrl" />
          </HBox>
        </bottom>
      </BorderPane>
    </Scene>
  </scene>
</fx:root>
