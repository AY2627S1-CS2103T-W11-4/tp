<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="command-box" spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label text="Command" styleClass="section-heading" labelFor="$commandTextField" />
  <HBox spacing="12" alignment="CENTER_LEFT">
    <TextField fx:id="commandTextField" onAction="#handleCommandEntered" HBox.hgrow="ALWAYS"
               promptText="Type a command and press Enter" accessibleText="Command" />
    <Button fx:id="runButton" text="Run ↵" mnemonicParsing="false" onAction="#handleCommandEntered"
            styleClass="run-button" />
  </HBox>
</VBox>
